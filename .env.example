# Contoh konfigurasi CCTV — salin ke .env lalu isi (JANGAN commit .env asli!).
# Format CAMS: NAMA=rtsp://USER:PASS@DVR_IP:554/user=USER&password=PASS&channel=N&stream=1.sdp?real_stream | (pisah kanal dengan |)
CAMS=depan=rtsp://USER:PASS@192.168.1.5:554/user=USER&password=PASS&channel=1&stream=1.sdp?real_stream
# Kanal yang diproses worker (pisah spasi, subset dari CAMS)
WORKERS=depan
# Kanal yang ditampilkan dashboard (pisah spasi, kosong = semua)
SHOW=depan
# Opsional: ganti host RTSP dengan domain sendiri (butuh port-forward 554). Kosong = IP DVR asli.
RTSP_HOST=
# URL publik tunnel (diisi otomatis oleh sync-tunnel-urls.sh)
CCTV_PUBURL=
